rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Helper: check if the requesting user is a student
    function isStudent() {
      return request.auth != null && request.auth.token.role == 'student';
    }

    // Helper: check if the user is the owner of this document
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Users collection
    match /users/{userId} {
      // Admins can read/write all user docs
      // Students can only read their own doc
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin();
    }

    // Classes collection and daily logs
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /dailyLogs/{date} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // Submissions
    match /submissions/{submissionId} {
      // Admins can read all submissions
      // Students can read their own submissions
      allow read: if isAdmin() || 
        (isStudent() && resource.data.studentId == request.auth.uid);
      
      // Students can create submissions for themselves
      allow create: if isStudent() && 
        request.resource.data.studentId == request.auth.uid;
      
      // Admins can update any submission (for overrides)
      // Cloud Functions also update via admin SDK (bypasses rules)
      allow update: if isAdmin();
      
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      // Admins see all notifications, students see their own
      allow read: if isAdmin() || 
        (request.auth != null && resource.data.recipientId == request.auth.uid);
      
      // Users can mark their own notifications as read
      allow update: if request.auth != null && 
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      
      // Only admin/functions create notifications
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Attendance
    match /attendance/{classId}/records/{dateStudentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Parent tokens — used for lookups by Cloud Functions only
    // No direct client access needed (parent view goes through Cloud Function)
    match /parentTokens/{tokenId} {
      allow read: if false;
      allow write: if isAdmin();
    }
  }
}
