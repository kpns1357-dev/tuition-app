# Firebase Web App Configuration
# Get these from Firebase Console > Project Settings > Your Web App
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# NOTE: The following secrets are NOT stored here.
# They are configured as Firebase Cloud Functions secrets:
#   - OPENROUTER_API_KEY (set via: firebase functions:secrets:set OPENROUTER_API_KEY)
#   - TWILIO_ACCOUNT_SID (set via: firebase functions:secrets:set TWILIO_ACCOUNT_SID)
#   - TWILIO_AUTH_TOKEN (set via: firebase functions:secrets:set TWILIO_AUTH_TOKEN)
#   - TWILIO_PHONE_NUMBER (set via: firebase functions:secrets:set TWILIO_PHONE_NUMBER)
